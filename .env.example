# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Server-side fetch from Next.js (host PNPM dev: use 127.0.0.1; Docker Compose overrides web → http://api:4000)
API_URL=http://127.0.0.1:4000

# Local application database
DATABASE_URL=postgresql://app_user:app_password@app-db:5432/sikili_sync

# Odoo
ODOO_URL=http://odoo:8069
ODOO_DB=sikili_assessment
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Odoo database container
ODOO_DB_HOST=odoo-db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# CORS (optional; defaults to localhost:3000)
# WEB_ORIGIN=http://localhost:3000
