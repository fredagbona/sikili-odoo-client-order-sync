# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Server-side fetch from Next.js (host PNPM dev: use 127.0.0.1; Docker Compose overrides web → http://api:4000)
API_URL=http://127.0.0.1:4000

# Local application database
DATABASE_URL=postgresql://app_user:app_password@app-db:5432/sikili_sync

# Odoo
ODOO_URL=http://odoo:8069
ODOO_DB=sikili_assessment
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Odoo database container
ODOO_DB_HOST=odoo-db
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo

# Frontend — browser calls this URL for mutations (must be public in production).
# In Docker Compose, set to your public API (e.g. https://api.example.com). Never leave as localhost on the server.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# CORS for the API: browser origin(s) of the Next app. Required on the **api** service in production.
# Comma-separated for multiple: WEB_ORIGIN=https://app.example.com,http://localhost:3000
# WEB_ORIGIN=http://localhost:3000

# If you run `next dev` behind a public hostname, add hostnames only (no https://):
# ALLOWED_DEV_ORIGINS=sikili.fredthedev.com
