generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

model Client {
  id            String     @id @default(cuid())
  name          String
  phone         String
  email         String
  odooPartnerId Int? @map("odoo_partner_id")
  syncStatus    SyncStatus @default(PENDING)
  syncError     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  orders        Order[]
}

model Order {
  id           String     @id @default(cuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  productName  String
  amount       Float
  odooOrderId  Int? @map("odoo_order_id")
  syncStatus   SyncStatus @default(PENDING)
  syncError    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([clientId])
}
